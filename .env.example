# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Identity Services Web Client ID (safe to expose to the browser)
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# Long random secret used to sign the HttpOnly session cookie. Never expose this to Vite.
SESSION_SECRET="replace-with-a-long-random-secret"

# Delivery store location, used only on the backend for availability and ETA.
# Set these to the real store coordinates; do not put them in frontend code.
STORE_LATITUDE=""
STORE_LONGITUDE=""
DELIVERY_RADIUS_KM="15"
GEOCODER_USER_AGENT="NomNoshDelivery/1.0"
